<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interactive playground: a REPL with examples and the full manual. Runs locally or in Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>expr</AssemblyName>
    <RootNamespace>ExpressionEngine.Playground</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The manual is compiled into the program so the playground always ships the manual that matches the code. -->
    <EmbeddedResource Include="..\..\docs\MANUAL.md" LogicalName="MANUAL.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpressionEngine\ExpressionEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExpressionEngine.Tests" />
  </ItemGroup>

</Project>
